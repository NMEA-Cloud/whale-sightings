# Copy this file to .env (gitignored, like every other .env in this repo) and fill in real
# values. Loaded by docker-compose.yml's peer-service entry via env_file: — see its comment
# there, and the README's "peer-service" section.
#
# The ID/secret printed by scripts/register-hydra-peer-client.sh — a peer:write
# client_credentials Hydra client, authenticating peer-service to OUR OWN service. Not a
# third-party credential; this only ever talks to this repo's own Hydra and service.
PEER_CLIENT_ID=
PEER_CLIENT_SECRET=
