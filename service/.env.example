# Used when running the service outside Docker (e.g. via uvicorn --reload)
VALKEY_HOST=localhost
VALKEY_PORT=6379
MQTT_HOST=localhost
MQTT_PORT=8883
# The broker (started via `docker compose up mqtt`, even when running the service itself
# outside Docker) requires TLS — no plain-MQTT listener exists. Path is relative to service/,
# matching the --ssl-certfile/--ssl-keyfile paths in the README's "outside Docker" section.
MQTT_CA_BUNDLE_PATH=../certs/rootCA.pem
CORS_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:8082,http://localhost:8083
