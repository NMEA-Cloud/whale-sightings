# Copy this file to .env.whale-alert-connector (gitignored, like .env) and fill in real
# values. Loaded by docker-compose.yml's whale-alert-connector service via env_file: — see
# its comment there, and the README's "Whale Alert connector" section for how to get each
# of these.
#
# The Whale Alert client ID/secret you already have (Group-Admin API access) — the
# connector's ONLY credential for talking to Whale Alert itself.
WHALE_ALERT_CLIENT_ID=
WHALE_ALERT_CLIENT_SECRET=

# A separate credential for a different system: the whale-sightings-ingest Hydra client
# registered via scripts/register-hydra-ingest-client.sh, authenticating the connector to
# OUR OWN service (sightings:ingest scope). Not the Whale Alert credential above.
INGEST_HYDRA_CLIENT_ID=
INGEST_HYDRA_CLIENT_SECRET=
